# ── Metode Login ──────────────────────────────────────────────────────────────
# Pilih salah satu metode login:
#   'otp'      → Login via nomor HP + kode OTP SMS (GOPAY_PHONE wajib diisi)
#   'password' → Login via email + password (GOPAY_EMAIL & GOPAY_PASSWORD wajib diisi)

GOPAY_LOGIN_METHOD=otp

# ── Login via Nomor HP + OTP ──────────────────────────────────────────────────
# Format: 08xxxxxxxxx atau +628xxxxxxxxx
GOPAY_PHONE=08123456789

# ── Login via Email + Password (alternatif) ───────────────────────────────────
GOPAY_EMAIL=your-email@example.com
GOPAY_PASSWORD=your-password

# ── QRIS & Pembayaran ─────────────────────────────────────────────────────────
# String QRIS statis milik merchant (didapat dari gambar QRIS GoPay kamu)
# Bisa scan gambar QRIS menggunakan scanner, lalu paste hasilnya di sini
QRIS_STRING=00020101021226...

# Nominal pembayaran default (dalam Rupiah), dipakai jika tidak ada argumen CLI
PRICE_AMOUNT=2000